# Nexora backend environment example.
# Copy to backend/.env and adjust. SQLite is used when DATABASE_URL is omitted.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Optional PostgreSQL connection. Example:
# DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora
